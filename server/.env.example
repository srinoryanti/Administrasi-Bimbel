# Salin file ini menjadi .env (di folder server/) lalu isi nilainya.
# Lokal (development): cukup kosongkan semua — SQLite file dipakai otomatis.
# Produksi (Render): isi D1_* dan B2_* — lihat README bagian "Deploy".

# --- Server ---
PORT=4000
NODE_ENV=production
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- Cloudflare D1 (database produksi) ---
# Dashboard Cloudflare → Workers & Pages / D1 → Overview & tab "API"
D1_ACCOUNT_ID=
D1_API_TOKEN=
D1_DATABASE_ID=

# --- Backblaze B2 (penyimpanan arsip, PDF rapor/kuitansi, ekspor laporan) ---
# B2 → App Keys → Add New Application Key (pilih bucket)
B2_KEY_ID=
B2_KEY=
B2_BUCKET=
B2_REGION=us-west-002
# B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com   (opsional, default sudah benar)

# --- Pilihan lokal ---
# DB_PATH=D:/path/ke/bimbel.db          (opsional, default server/data/bimbel.db)
# D1_CHUNK_SIZE=25                      (opsional, jumlah statement per batch migrasi)

# --- Skrip create-admin (opsional) ---
ADMIN_USERNAME=direktur
ADMIN_EMAIL=
ADMIN_PASSWORD=
